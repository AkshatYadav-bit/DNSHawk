$ORIGIN dev.test.
$TTL 3600

@ IN SOA ns.dev.test. admin.dev.test. (
    2026101303 ; Serial
    3600     ; Refresh
    600      ; Retry
    86400    ; Expire
    3600     ; Negative cache TTL
)

@  IN NS ns.dev.test.
ns IN A  192.168.111.1

frontend IN A    192.168.111.20
backend  IN A    192.168.111.21
registry IN A    192.168.111.22
metrics  IN A    192.168.111.23
staging  IN A    192.168.111.24
